# Backend settings. Copy to backend/.env and adjust. Never commit .env: this repository is public.
# The defaults run a local game with no tracing; leave a line commented out to keep its default.

# --- Storage ------------------------------------------------------------------------------
# Where games are stored. SQLite needs no setup; Postgres comes from `docker compose up -d`.
MM_DATABASE_URL=sqlite+aiosqlite:///./runs/murdertown.sqlite3
# MM_DATABASE_URL=postgresql+asyncpg://murdertown:murdertown@localhost:5433/murdertown

# Browser origins allowed to call the API, as a JSON list.
MM_CORS_ORIGINS=["http://localhost:5173"]

# Games the server left running (it crashed or was stopped) resume when it starts again.
# MM_RESUME_ON_BOOT=true
# On shutdown, how long to wait for decisions already asked, so their model calls are kept.
# MM_SHUTDOWN_GRACE_SECONDS=200

# --- Tracing (OpenTelemetry) --------------------------------------------------------------
# Langfuse: create a project, then copy its API keys here. Traces go to Langfuse when both are set.
# MM_LANGFUSE_PUBLIC_KEY=pk-lf-...
# MM_LANGFUSE_SECRET_KEY=sk-lf-...
# EU cloud by default; https://us.cloud.langfuse.com for the US region, or a self-hosted URL.
# MM_LANGFUSE_HOST=https://cloud.langfuse.com

# Any other OTLP/HTTP traces endpoint, e.g. Jaeger from `docker compose --profile tracing up -d`:
# MM_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Print every span to the terminal (true or false).
# MM_TRACE_CONSOLE=true

# --- Model providers ------------------------------------------------------------------------
# A lineup can put Residents on these (see docs/providers.md). Each needs its own API key.
# With MM_ANTHROPIC_API_KEY set, "claude" plays on the Anthropic API instead of the subscription.
# MM_ANTHROPIC_API_KEY=
# MM_OPENAI_API_KEY=
# MM_OPENROUTER_API_KEY=
# MM_GEMINI_API_KEY=
# MM_XAI_API_KEY=
# A model with no price cannot play. Prices are dollars per million tokens, as JSON:
# MM_MODEL_PRICES={"gpt-5-mini": {"input": 0.25, "output": 2.0, "cache_read": 0.025}}

# --- Claude ------------------------------------------------------------------------------
# Live games run on your Claude subscription through the Claude Agent SDK.
# Do NOT set ANTHROPIC_API_KEY or ANTHROPIC_AUTH_TOKEN: live games refuse to start if either is set.
