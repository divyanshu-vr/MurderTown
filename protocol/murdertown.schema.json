{
  "$defs": {
    "AttackThwarted": {
      "additionalProperties": false,
      "description": "Dawn's news that the Murderers attacked someone the Doctor had protected.",
      "properties": {
        "type": {
          "const": "attack_thwarted",
          "default": "attack_thwarted",
          "type": "string"
        },
        "saved": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "saved"
      ],
      "title": "AttackThwarted",
      "type": "object"
    },
    "BallotCast": {
      "additionalProperties": false,
      "description": "One Resident's ballot, revealed once every ballot of the Vote has been cast.",
      "properties": {
        "type": {
          "const": "ballot_cast",
          "default": "ballot_cast",
          "type": "string"
        },
        "voter": {
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "voter",
        "target"
      ],
      "title": "BallotCast",
      "type": "object"
    },
    "BidPlaced": {
      "additionalProperties": false,
      "description": "How urgently one Resident wants to make the next Statement on the Open floor.",
      "properties": {
        "type": {
          "const": "bid_placed",
          "default": "bid_placed",
          "type": "string"
        },
        "resident": {
          "type": "string"
        },
        "urgency": {
          "type": "integer"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "resident",
        "urgency",
        "reason"
      ],
      "title": "BidPlaced",
      "type": "object"
    },
    "ConversationMessagePosted": {
      "additionalProperties": false,
      "description": "One message in a Conversation, heard only by the two Residents in it.",
      "properties": {
        "type": {
          "const": "conversation_message_posted",
          "default": "conversation_message_posted",
          "type": "string"
        },
        "speaker": {
          "type": "string"
        },
        "partner": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "ends_conversation": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "speaker",
        "partner",
        "text",
        "ends_conversation"
      ],
      "title": "ConversationMessagePosted",
      "type": "object"
    },
    "ConversationStarted": {
      "additionalProperties": false,
      "description": "Two Residents slip away to talk. Everyone sees that they met, but not who asked whom.",
      "properties": {
        "type": {
          "const": "conversation_started",
          "default": "conversation_started",
          "type": "string"
        },
        "residents": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "string"
            },
            {
              "type": "string"
            }
          ],
          "type": "array"
        }
      },
      "required": [
        "type",
        "residents"
      ],
      "title": "ConversationStarted",
      "type": "object"
    },
    "DecisionFellBack": {
      "additionalProperties": false,
      "description": "A decision source could not give a usable answer, so a safe default was used instead.",
      "properties": {
        "type": {
          "const": "decision_fell_back",
          "default": "decision_fell_back",
          "type": "string"
        },
        "resident": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/DecisionKind"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "resident",
        "kind",
        "reason"
      ],
      "title": "DecisionFellBack",
      "type": "object"
    },
    "DecisionKind": {
      "enum": [
        "statement",
        "bid",
        "showdown",
        "ballot",
        "last_words",
        "reflection",
        "den_message",
        "kill_vote",
        "protect",
        "investigate",
        "recap",
        "dusk_intent",
        "conversation_message"
      ],
      "title": "DecisionKind",
      "type": "string"
    },
    "DenMessagePosted": {
      "additionalProperties": false,
      "description": "One Murderer's message to the others, perhaps proposing tonight's Victim.",
      "properties": {
        "den": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "type": {
          "const": "den_message_posted",
          "default": "den_message_posted",
          "type": "string"
        },
        "murderer": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "proposed_victim": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "den",
        "type",
        "murderer",
        "text",
        "proposed_victim"
      ],
      "title": "DenMessagePosted",
      "type": "object"
    },
    "DuskIntentChosen": {
      "additionalProperties": false,
      "description": "What a Resident means to do at Dusk: talk, wander or do a chore. Only they know.",
      "properties": {
        "type": {
          "const": "dusk_intent_chosen",
          "default": "dusk_intent_chosen",
          "type": "string"
        },
        "resident": {
          "type": "string"
        },
        "activity": {
          "enum": [
            "talk",
            "wander",
            "chore"
          ],
          "type": "string"
        },
        "partners": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "topic": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "resident",
        "activity",
        "partners",
        "topic"
      ],
      "title": "DuskIntentChosen",
      "type": "object"
    },
    "Effort": {
      "description": "How hard the model thinks before answering: more effort, slower and dearer answers.",
      "enum": [
        "low",
        "medium",
        "high",
        "max"
      ],
      "title": "Effort",
      "type": "string"
    },
    "Event": {
      "description": "One entry in a game's log: a payload stamped with its place in the game.",
      "properties": {
        "seq": {
          "type": "integer"
        },
        "day": {
          "type": "integer"
        },
        "phase": {
          "$ref": "#/$defs/Phase"
        },
        "visibility": {
          "$ref": "#/$defs/Visibility"
        },
        "decision_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "payload": {
          "discriminator": {
            "mapping": {
              "attack_thwarted": "#/$defs/AttackThwarted",
              "ballot_cast": "#/$defs/BallotCast",
              "bid_placed": "#/$defs/BidPlaced",
              "conversation_message_posted": "#/$defs/ConversationMessagePosted",
              "conversation_started": "#/$defs/ConversationStarted",
              "decision_fell_back": "#/$defs/DecisionFellBack",
              "den_message_posted": "#/$defs/DenMessagePosted",
              "dusk_intent_chosen": "#/$defs/DuskIntentChosen",
              "game_ended": "#/$defs/GameEnded",
              "game_started": "#/$defs/GameStarted",
              "kill_vote_cast": "#/$defs/KillVoteCast",
              "last_words_spoken": "#/$defs/LastWordsSpoken",
              "phase_started": "#/$defs/PhaseStarted",
              "recap_narrated": "#/$defs/RecapNarrated",
              "reflection_written": "#/$defs/ReflectionWritten",
              "resident_died": "#/$defs/ResidentDied",
              "resident_investigated": "#/$defs/ResidentInvestigated",
              "resident_protected": "#/$defs/ResidentProtected",
              "role_assigned": "#/$defs/RoleAssigned",
              "sheriff_fired": "#/$defs/SheriffFired",
              "sheriff_held_fire": "#/$defs/SheriffHeldFire",
              "statement_made": "#/$defs/StatementMade",
              "victim_chosen": "#/$defs/VictimChosen",
              "vote_resolved": "#/$defs/VoteResolved"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/GameStarted"
            },
            {
              "$ref": "#/$defs/RoleAssigned"
            },
            {
              "$ref": "#/$defs/PhaseStarted"
            },
            {
              "$ref": "#/$defs/BidPlaced"
            },
            {
              "$ref": "#/$defs/StatementMade"
            },
            {
              "$ref": "#/$defs/SheriffFired"
            },
            {
              "$ref": "#/$defs/SheriffHeldFire"
            },
            {
              "$ref": "#/$defs/BallotCast"
            },
            {
              "$ref": "#/$defs/VoteResolved"
            },
            {
              "$ref": "#/$defs/LastWordsSpoken"
            },
            {
              "$ref": "#/$defs/ResidentDied"
            },
            {
              "$ref": "#/$defs/DenMessagePosted"
            },
            {
              "$ref": "#/$defs/KillVoteCast"
            },
            {
              "$ref": "#/$defs/VictimChosen"
            },
            {
              "$ref": "#/$defs/ResidentProtected"
            },
            {
              "$ref": "#/$defs/ResidentInvestigated"
            },
            {
              "$ref": "#/$defs/AttackThwarted"
            },
            {
              "$ref": "#/$defs/RecapNarrated"
            },
            {
              "$ref": "#/$defs/DuskIntentChosen"
            },
            {
              "$ref": "#/$defs/ConversationStarted"
            },
            {
              "$ref": "#/$defs/ConversationMessagePosted"
            },
            {
              "$ref": "#/$defs/ReflectionWritten"
            },
            {
              "$ref": "#/$defs/DecisionFellBack"
            },
            {
              "$ref": "#/$defs/GameEnded"
            }
          ]
        }
      },
      "required": [
        "seq",
        "day",
        "phase",
        "visibility",
        "decision_id",
        "payload"
      ],
      "title": "Event",
      "type": "object"
    },
    "EventPage": {
      "properties": {
        "events": {
          "items": {
            "$ref": "#/$defs/Event"
          },
          "type": "array"
        }
      },
      "required": [
        "events"
      ],
      "title": "EventPage",
      "type": "object"
    },
    "Explanation": {
      "description": "The decision behind an event: every model attempt at it, and the fallback if one was used.\n\nA decision made by a scripted bot has no attempts, because no model was asked.",
      "properties": {
        "event": {
          "$ref": "#/$defs/Event"
        },
        "attempts": {
          "items": {
            "$ref": "#/$defs/ModelCall"
          },
          "type": "array"
        },
        "fallback_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "event",
        "attempts",
        "fallback_reason"
      ],
      "title": "Explanation",
      "type": "object"
    },
    "GameConfig-Input": {
      "additionalProperties": false,
      "properties": {
        "residents": {
          "default": 12,
          "maximum": 15,
          "minimum": 6,
          "type": "integer"
        },
        "murderers": {
          "default": 2,
          "maximum": 3,
          "minimum": 1,
          "type": "integer"
        },
        "doctor": {
          "default": true,
          "type": "boolean"
        },
        "detective": {
          "default": true,
          "type": "boolean"
        },
        "sheriff": {
          "default": true,
          "type": "boolean"
        },
        "max_days": {
          "default": 10,
          "maximum": 20,
          "minimum": 1,
          "type": "integer"
        },
        "open_floor_statements": {
          "default": 8,
          "maximum": 20,
          "minimum": 0,
          "type": "integer"
        },
        "open_floor_seconds": {
          "anyOf": [
            {
              "maximum": 3600,
              "minimum": 10,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 300
        },
        "sheriff_shoots_at": {
          "default": "showdown",
          "enum": [
            "showdown",
            "night"
          ],
          "type": "string"
        },
        "detective_accuracy": {
          "default": 0.8,
          "maximum": 1.0,
          "minimum": 0.5,
          "type": "number"
        },
        "dawn_names_the_saved": {
          "default": true,
          "type": "boolean"
        },
        "seed": {
          "default": 0,
          "type": "integer"
        }
      },
      "title": "GameConfigInput",
      "type": "object"
    },
