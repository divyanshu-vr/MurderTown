{
  "$defs": {
    "BallotCast": {
      "additionalProperties": false,
      "description": "One Resident's ballot, revealed once every ballot of the Vote has been cast.",
      "properties": {
        "type": {
          "const": "ballot_cast",
          "default": "ballot_cast",
          "type": "string"
        },
        "voter": {
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "voter",
        "target"
      ],
      "title": "BallotCast",
      "type": "object"
    },
    "BidPlaced": {
      "additionalProperties": false,
      "description": "How urgently one Resident wants to make the next Statement on the Open floor.",
      "properties": {
        "type": {
          "const": "bid_placed",
          "default": "bid_placed",
          "type": "string"
        },
        "resident": {
          "type": "string"
        },
        "urgency": {
          "type": "integer"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "resident",
        "urgency",
        "reason"
      ],
      "title": "BidPlaced",
      "type": "object"
    },
    "DecisionFellBack": {
      "additionalProperties": false,
      "description": "A decision source could not give a usable answer, so a safe default was used instead.",
      "properties": {
        "type": {
          "const": "decision_fell_back",
          "default": "decision_fell_back",
          "type": "string"
        },
        "resident": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/DecisionKind"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "resident",
        "kind",
        "reason"
      ],
      "title": "DecisionFellBack",
      "type": "object"
    },
    "DecisionKind": {
      "enum": [
        "statement",
        "bid",
        "showdown",
        "ballot",
        "last_words",
        "reflection"
      ],
      "title": "DecisionKind",
      "type": "string"
    },
    "Event": {
      "description": "One entry in a game's log: a payload stamped with its place in the game.",
      "properties": {
        "seq": {
          "type": "integer"
        },
        "day": {
          "type": "integer"
        },
        "phase": {
          "$ref": "#/$defs/Phase"
        },
        "visibility": {
          "$ref": "#/$defs/Visibility"
        },
        "decision_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "payload": {
          "discriminator": {
            "mapping": {
              "ballot_cast": "#/$defs/BallotCast",
              "bid_placed": "#/$defs/BidPlaced",
              "decision_fell_back": "#/$defs/DecisionFellBack",
              "game_ended": "#/$defs/GameEnded",
              "game_started": "#/$defs/GameStarted",
              "last_words_spoken": "#/$defs/LastWordsSpoken",
              "phase_started": "#/$defs/PhaseStarted",
              "reflection_written": "#/$defs/ReflectionWritten",
              "resident_died": "#/$defs/ResidentDied",
              "role_assigned": "#/$defs/RoleAssigned",
              "sheriff_fired": "#/$defs/SheriffFired",
              "statement_made": "#/$defs/StatementMade",
              "vote_resolved": "#/$defs/VoteResolved"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/GameStarted"
            },
            {
              "$ref": "#/$defs/RoleAssigned"
            },
            {
              "$ref": "#/$defs/PhaseStarted"
            },
            {
              "$ref": "#/$defs/BidPlaced"
            },
            {
              "$ref": "#/$defs/StatementMade"
            },
            {
              "$ref": "#/$defs/SheriffFired"
            },
            {
              "$ref": "#/$defs/BallotCast"
            },
            {
              "$ref": "#/$defs/VoteResolved"
            },
            {
              "$ref": "#/$defs/LastWordsSpoken"
            },
            {
              "$ref": "#/$defs/ResidentDied"
            },
            {
              "$ref": "#/$defs/ReflectionWritten"
            },
            {
              "$ref": "#/$defs/DecisionFellBack"
            },
            {
              "$ref": "#/$defs/GameEnded"
            }
          ]
        }
      },
      "required": [
        "seq",
        "day",
        "phase",
        "visibility",
        "decision_id",
        "payload"
      ],
      "title": "Event",
      "type": "object"
    },
    "EventPage": {
      "properties": {
        "events": {
          "items": {
            "$ref": "#/$defs/Event"
          },
          "type": "array"
        }
      },
      "required": [
        "events"
      ],
      "title": "EventPage",
      "type": "object"
    },
    "GameConfig-Input": {
      "additionalProperties": false,
      "properties": {
        "residents": {
          "default": 12,
          "maximum": 15,
          "minimum": 6,
          "type": "integer"
        },
        "murderers": {
          "default": 2,
          "maximum": 3,
          "minimum": 1,
          "type": "integer"
        },
        "doctor": {
          "default": true,
          "type": "boolean"
        },
        "detective": {
          "default": true,
          "type": "boolean"
        },
        "sheriff": {
          "default": true,
          "type": "boolean"
        },
        "max_days": {
          "default": 10,
          "maximum": 20,
          "minimum": 1,
          "type": "integer"
        },
        "open_floor_statements": {
          "default": 8,
          "maximum": 20,
          "minimum": 0,
          "type": "integer"
        },
        "open_floor_seconds": {
          "anyOf": [
            {
              "maximum": 3600,
              "minimum": 10,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 300
        },
        "sheriff_shoots_at": {
          "default": "showdown",
          "enum": [
            "showdown",
            "night"
          ],
          "type": "string"
        },
        "seed": {
          "default": 0,
          "type": "integer"
        }
      },
      "title": "GameConfigInput",
      "type": "object"
    },
    "GameConfig-Output": {
      "additionalProperties": false,
      "properties": {
        "residents": {
          "default": 12,
          "maximum": 15,
          "minimum": 6,
          "type": "integer"
        },
        "murderers": {
          "default": 2,
          "maximum": 3,
          "minimum": 1,
          "type": "integer"
        },
        "doctor": {
          "default": true,
          "type": "boolean"
        },
        "detective": {
          "default": true,
          "type": "boolean"
        },
        "sheriff": {
          "default": true,
          "type": "boolean"
        },
        "max_days": {
          "default": 10,
          "maximum": 20,
          "minimum": 1,
          "type": "integer"
        },
        "open_floor_statements": {
          "default": 8,
          "maximum": 20,
          "minimum": 0,
          "type": "integer"
        },
        "open_floor_seconds": {
          "anyOf": [
            {
              "maximum": 3600,
              "minimum": 10,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 300
        },
        "sheriff_shoots_at": {
          "default": "showdown",
          "enum": [
            "showdown",
            "night"
          ],
          "type": "string"
        },
        "seed": {
          "default": 0,
          "type": "integer"
        }
      },
      "required": [
        "residents",
        "murderers",
        "doctor",
        "detective",
        "sheriff",
        "max_days",
        "open_floor_statements",
        "open_floor_seconds",
        "sheriff_shoots_at",
        "seed"
      ],
      "title": "GameConfig",
      "type": "object"
    },
    "GameCreated": {
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "GameCreated",
      "type": "object"
    },
    "GameEnded": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "game_ended",
          "default": "game_ended",
          "type": "string"
        },
        "winner": {
          "$ref": "#/$defs/Side"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "winner",
        "reason"
      ],
      "title": "GameEnded",
      "type": "object"
    },
    "GameStarted": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "game_started",
          "default": "game_started",
          "type": "string"
        },
        "config": {
          "$ref": "#/$defs/GameConfig-Output"
        },
        "residents": {
          "items": {
            "$ref": "#/$defs/Resident"
          },
          "type": "array"
        }
      },
      "required": [
        "type",
        "config",
        "residents"
      ],
      "title": "GameStarted",
      "type": "object"
    },
    "GameSummary": {
      "properties": {
        "id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "running",
            "finished",
            "failed"
          ],
          "type": "string"
        },
        "config": {
          "$ref": "#/$defs/GameConfig-Output"
        },
        "winner": {
          "anyOf": [
            {
              "$ref": "#/$defs/Side"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_seq": {
          "type": "integer"
        }
      },
      "required": [
        "id",
        "status",
        "config",
        "winner",
        "last_seq"
      ],
      "title": "GameSummary",
      "type": "object"
    },
    "LastWordsSpoken": {
      "additionalProperties": false,
      "description": "What a banished Resident says before their role is revealed.",
      "properties": {
        "type": {
          "const": "last_words_spoken",
          "default": "last_words_spoken",
          "type": "string"
        },
        "resident": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "resident",
        "text"
      ],
      "title": "LastWordsSpoken",
      "type": "object"
    },
    "Persona": {
      "properties": {
        "occupation": {
          "type": "string"
        },
        "temperament": {
          "type": "string"
        },
        "speaking_style": {
          "type": "string"
        },
        "quirk": {
          "type": "string"
        }
      },
      "required": [
        "occupation",
        "temperament",
        "speaking_style",
        "quirk"
      ],
      "title": "Persona",
      "type": "object"
    },
    "Phase": {
      "enum": [
        "setup",
        "dawn",
        "discussion",
        "showdown",
        "vote",
        "dusk",
        "night",
        "ended"
      ],
      "title": "Phase",
      "type": "string"
    },
    "PhaseStarted": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "phase_started",
          "default": "phase_started",
          "type": "string"
        },
        "day": {
          "type": "integer"
        },
        "phase": {
          "$ref": "#/$defs/Phase"
        }
      },
      "required": [
        "type",
        "day",
        "phase"
      ],
      "title": "PhaseStarted",
      "type": "object"
    },
    "ReflectionWritten": {
      "additionalProperties": false,
      "description": "A Resident's private journal entry, rewritten notebook and changed suspicions.",
      "properties": {
        "type": {
          "const": "reflection_written",
          "default": "reflection_written",
          "type": "string"
        },
        "resident": {
          "type": "string"
        },
        "journal_entry": {
          "type": "string"
        },
        "notebook": {
          "type": "string"
        },
        "suspicions": {
          "items": {
            "$ref": "#/$defs/Suspicion"
          },
          "type": "array"
        }
      },
      "required": [
        "type",
        "resident",
        "journal_entry",
        "notebook",
        "suspicions"
      ],
      "title": "ReflectionWritten",
      "type": "object"
    },
    "Resident": {
      "description": "A character in the town. The seat fixes their house and their place in every ordering.",
      "properties": {
        "name": {
          "type": "string"
        },
        "seat": {
          "type": "integer"
        },
        "occupation": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "seat",
        "occupation"
      ],
      "title": "Resident",
      "type": "object"
    },
    "ResidentDied": {
      "additionalProperties": false,
      "description": "A death, announced to everyone with the dead Resident's role.\n\nA Resident is banished by Vote or shot by the Sheriff; a Sheriff who shoots a\nTown Resident dies of the backfire.",
      "properties": {
        "type": {
          "const": "resident_died",
          "default": "resident_died",
          "type": "string"
        },
        "resident": {
          "type": "string"
        },
        "cause": {
          "enum": [
            "banished",
            "shot",
            "backfire"
          ],
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/Role"
        }
      },
      "required": [
        "type",
        "resident",
        "cause",
        "role"
      ],
      "title": "ResidentDied",
      "type": "object"
    },
    "Role": {
      "enum": [
        "murderer",
        "doctor",
        "detective",
        "sheriff",
        "civilian"
      ],
      "title": "Role",
      "type": "string"
    },
    "RoleAssigned": {
      "additionalProperties": false,
      "description": "A Resident learns their role and persona. Murderers also learn who their teammates are.",
      "properties": {
        "type": {
          "const": "role_assigned",
          "default": "role_assigned",
          "type": "string"
        },
        "resident": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/Role"
        },
        "persona": {
          "$ref": "#/$defs/Persona"
        },
        "teammates": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "type",
        "resident",
        "role",
        "persona",
        "teammates"
      ],
      "title": "RoleAssigned",
      "type": "object"
    },
    "SheriffFired": {
      "additionalProperties": false,
      "description": "The Sheriff spends the single bullet. Whoever is hit, and perhaps the Sheriff, dies next.",
      "properties": {
        "type": {
          "const": "sheriff_fired",
          "default": "sheriff_fired",
          "type": "string"
        },
        "sheriff": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "hit_a_murderer": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "sheriff",
        "target",
        "hit_a_murderer"
      ],
      "title": "SheriffFired",
      "type": "object"
    },
    "Side": {
      "enum": [
        "town",
        "murderers"
      ],
      "title": "Side",
      "type": "string"
    },
    "StatementMade": {
      "additionalProperties": false,
      "description": "A Statement, with what it does: whom it names, accuses and defends, and any role claim.",
      "properties": {
        "type": {
          "const": "statement_made",
          "default": "statement_made",
          "type": "string"
        },
        "speaker": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "part": {
          "enum": [
            "opening_round",
            "open_floor"
          ],
          "type": "string"
        },
        "addressed": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "accused": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "defended": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "claimed_role": {
          "anyOf": [
            {
              "$ref": "#/$defs/Role"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "type",
        "speaker",
        "text",
        "part",
        "addressed",
        "accused",
        "defended",
        "claimed_role"
      ],
      "title": "StatementMade",
      "type": "object"
    },
    "Suspicion": {
      "additionalProperties": false,
      "properties": {
        "resident": {
          "description": "Another Resident's name.",
          "type": "string"
        },
        "suspicion": {
          "description": "0 = certainly innocent, 100 = certainly a Murderer.",
          "maximum": 100,
          "minimum": 0,
          "type": "integer"
        },
        "note": {
          "description": "Why, in a few words.",
          "type": "string"
        }
      },
      "required": [
        "resident",
        "suspicion",
        "note"
      ],
      "title": "Suspicion",
      "type": "object"
    },
    "Visibility": {
      "description": "Who may perceive an event: everyone, a named set of Residents, or Spectators only.",
      "properties": {
        "scope": {
          "enum": [
            "everyone",
            "residents",
            "spectators"
          ],
          "type": "string"
        },
        "residents": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "scope",
        "residents"
      ],
      "title": "Visibility",
      "type": "object"
    },
    "VoteResolved": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "vote_resolved",
          "default": "vote_resolved",
          "type": "string"
        },
        "tally": {
          "additionalProperties": {
            "type": "integer"
          },
          "type": "object"
        },
        "skips": {
          "type": "integer"
        },
        "banished": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "tally",
        "skips",
        "banished"
      ],
      "title": "VoteResolved",
      "type": "object"
    }
  },
  "title": "MurderTown protocol"
}
