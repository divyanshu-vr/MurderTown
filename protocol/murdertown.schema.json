          "type": "integer"
        },
        "trace_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "decision_id",
        "resident",
        "kind",
        "attempt",
        "provider",
        "model",
        "effort",
        "prompt_version",
        "system",
        "prompt",
        "outcome",
        "problem",
        "raw_text",
        "answer",
        "input_tokens",
        "output_tokens",
        "cache_read_tokens",
        "cache_write_tokens",
        "cost_usd",
        "latency_ms",
        "trace_id"
      ],
      "title": "ModelCall",
      "type": "object"
    },
    "Persona": {
      "properties": {
        "occupation": {
          "type": "string"
        },
        "temperament": {
          "type": "string"
        },
        "speaking_style": {
          "type": "string"
        },
        "quirk": {
          "type": "string"
        }
      },
      "required": [
        "occupation",
        "temperament",
        "speaking_style",
        "quirk"
      ],
      "title": "Persona",
      "type": "object"
    },
    "Phase": {
      "enum": [
        "setup",
