    "GameCreated": {
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "GameCreated",
      "type": "object"
    },
    "GameEnded": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "game_ended",
          "default": "game_ended",
          "type": "string"
        },
        "winner": {
          "$ref": "#/$defs/Side"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "winner",
        "reason"
      ],
      "title": "GameEnded",
      "type": "object"
    },
    "GameStarted": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "game_started",
          "default": "game_started",
          "type": "string"
        },
        "config": {
          "$ref": "#/$defs/GameConfig-Output"
        },
        "residents": {
          "items": {
            "$ref": "#/$defs/Resident"
          },
          "type": "array"
        }
      },
      "required": [
        "type",
        "config",
        "residents"
      ],
      "title": "GameStarted",
      "type": "object"
    },
    "GameSummary": {
      "properties": {
        "id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "running",
            "finished",
            "failed"
          ],
          "type": "string"
        },
        "config": {
          "$ref": "#/$defs/GameConfig-Output"
        },
        "winner": {
          "anyOf": [
            {
              "$ref": "#/$defs/Side"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_seq": {
          "type": "integer"
        }
      },
      "required": [
        "id",
        "status",
        "config",
        "winner",
        "last_seq"
      ],
      "title": "GameSummary",
      "type": "object"
    },
    "JournalEntry": {
      "properties": {
        "day": {
          "type": "integer"
        },
        "phase": {
          "$ref": "#/$defs/Phase"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "day",
        "phase",
        "text"
      ],
      "title": "JournalEntry",
      "type": "object"
    },
    "KillVoteCast": {
      "additionalProperties": false,
      "description": "One Murderer's choice of Victim; a lone Murderer's choice settles it.",
      "properties": {
        "den": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "type": {
          "const": "kill_vote_cast",
          "default": "kill_vote_cast",
          "type": "string"
        },
        "murderer": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      },
      "required": [
        "den",
        "type",
        "murderer",
        "target"
      ],
      "title": "KillVoteCast",
      "type": "object"
    },
    "LastWordsSpoken": {
      "additionalProperties": false,
      "description": "What a banished Resident says before their role is revealed.",
      "properties": {
        "type": {
          "const": "last_words_spoken",
          "default": "last_words_spoken",
          "type": "string"
        },
        "resident": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "resident",
        "text"
      ],
      "title": "LastWordsSpoken",
      "type": "object"
    },
    "Memory": {
      "description": "What a Resident carries in mind from one decision to the next.",
      "properties": {
        "notebook": {
          "type": "string"
        },
        "journal": {
          "items": {
            "$ref": "#/$defs/JournalEntry"
          },
          "type": "array"
        },
        "dossier": {
          "items": {
            "$ref": "#/$defs/Suspicion"
          },
          "type": "array"
        }
      },
      "required": [
        "notebook",
        "journal",
        "dossier"
      ],
      "title": "Memory",
      "type": "object"
    },
    "Mind": {
