        "sheriff",
        "max_days",
        "open_floor_statements",
        "open_floor_seconds",
        "sheriff_shoots_at",
        "detective_accuracy",
        "dawn_names_the_saved",
        "seed"
      ],
      "title": "GameConfig",
      "type": "object"
