      "properties": {
        "decision_id": {
          "type": "string"
        },
        "resident": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/DecisionKind"
        },
        "attempt": {
          "type": "integer"
        },
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "effort": {
