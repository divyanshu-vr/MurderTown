# Frontend settings. Copy to frontend/.env.local and adjust. Never commit it: this repository is public.

# Where the backend API runs.
VITE_API_URL=http://127.0.0.1:8000

# Link each model attempt in the Mind inspector's "why?" drawer to its trace.
# {traceId} is replaced by the attempt's trace id. Examples:
#   Langfuse: https://cloud.langfuse.com/project/<your project id>/traces/{traceId}
#   Jaeger:   http://localhost:16686/trace/{traceId}
# VITE_TRACE_URL=https://cloud.langfuse.com/project/<your project id>/traces/{traceId}
